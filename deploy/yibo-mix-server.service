[Unit]
Description=Yibo Batch Mix Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fczj/.local/share/yibo-mix-server
Environment=MIX_SERVER_HOST=0.0.0.0
Environment=MIX_SERVER_PORT=8787
Environment=MIX_SERVER_MAX_CONCURRENT_JOBS=2
Environment=MIX_SERVER_PROJECT_RETENTION_HOURS=24
EnvironmentFile=/home/fczj/.config/yibo-mix-server.env
ExecStart=/home/fczj/.local/node-v22/bin/node dist-electron/electron/server/mixServer.js -- --workspace /home/fczj/mix-work
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
